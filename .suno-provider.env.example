# Copy this file to .suno-provider.env and fill in your private provider key.
# Providers currently supported: sunoapi, apixo
SUNO_PROVIDER=sunoapi
SUNO_PROVIDER_API_KEY=replace-with-provider-api-key
SUNO_INGEST_TOKEN=replace-with-thismoment-ingest-token
SUNO_WEBHOOK_SECRET=replace-with-webhook-secret
SUNO_PLAYLIST_NAME=Fresh Suno
SUNO_MODEL=V5_5
SUNO_PROVIDER_INTERVAL=30
